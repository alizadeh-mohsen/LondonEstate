<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LondonEstate.MobileApp.Pages.Admin.DashboardPage"
             Title="Rent estimate"
             BackgroundColor="#F4F5F7">

    <ContentPage.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
                    <Setter Property="StrokeShape" Value="RoundedRectangle 12" />
                    <Setter Property="Stroke" Value="Transparent" />
                    <Setter Property="HeightRequest" Value="120" />
                    <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="CardLabelStyle" TargetType="Label">
                    <Setter Property="TextColor" Value="White" />
                    <Setter Property="FontSize" Value="20" />
                    <Setter Property="FontAttributes" Value="Bold" />
                    <Setter Property="HorizontalOptions" Value="Center" />
                    <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <Grid Padding="16"
              RowSpacing="16"
              ColumnSpacing="16"
              RowDefinitions="Auto,Auto"
              ColumnDefinitions="*,*">

            <!-- Bookings -->
            <Border Grid.Row="0" Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    BackgroundColor="#0d6efd">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBookingsTapped" />
                </Border.GestureRecognizers>
                <Label Text="Bookings" Style="{StaticResource CardLabelStyle}" />
            </Border>

            <!-- Greetings -->
            <Border Grid.Row="0" Grid.Column="1"
                    Style="{StaticResource CardStyle}"
                    BackgroundColor="#198754">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnGreetingsTapped" />
                </Border.GestureRecognizers>
                <Label Text="Greetings" Style="{StaticResource CardLabelStyle}" />
            </Border>

            <!-- Instructions -->
            <Border Grid.Row="1" Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    BackgroundColor="#ffc107">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnInstructionsTapped" />
                </Border.GestureRecognizers>
                <Label Text="Instructions" Style="{StaticResource CardLabelStyle}" TextColor="#212529" />
            </Border>

            <!-- Invoices -->
            <Border Grid.Row="1" Grid.Column="1"
                    Style="{StaticResource CardStyle}"
                    BackgroundColor="#0dcaf0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnInvoicesTapped" />
                </Border.GestureRecognizers>
                <Label Text="Invoices" Style="{StaticResource CardLabelStyle}" TextColor="#212529" />
            </Border>

        </Grid>
    </ScrollView>
</ContentPage>