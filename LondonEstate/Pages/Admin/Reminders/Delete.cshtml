@page
@model LondonEstate.Pages.Admin.reminders.DeleteModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Flat</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Reminder.Due)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Reminder.Note)
        </dd>
        
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="Reminder.Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Cancel</a>
    </form>
</div>
