@page
@model LondonEstate.Pages.Admin.Reminders.CreateModel

@{
    ViewData["Title"] = "Create";
}


<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Reminder.Due" class="control-label"></label>
                <input asp-for="Reminder.Due" class="form-control" />
                <span asp-validation-for="Reminder.Due" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Reminder.Note" class="control-label"></label>
                <input asp-for="Reminder.Note" class="form-control" />
                <span asp-validation-for="Reminder.Note" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary my-3" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Cancel</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
