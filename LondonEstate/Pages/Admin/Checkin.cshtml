@page
@model LondonEstate.Pages.Admin.CheckinModel

@{
    ViewData["Title"] = "Checkin";
}

<span class="fw-bold">@Html.DisplayFor(model => model.Flat.Name)</span>
<br />
<div>
    @foreach (var listing in Model.Flat.Listings)
    {
        <small class="text-muted d-block"><i>@listing.ListingName</i></small>
    }
</div>
<hr />
<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Flat.Id" />

            <div class="form-group">
                <label asp-for="Flat.CheckIn" class="control-label">Check in</label>
                <input type="date" asp-for="Flat.CheckIn" class="form-control" />
                <span asp-validation-for="Flat.CheckIn" class="text-danger"></span>
            </div>
            <div class="form-group mt-2">
                <label asp-for="Flat.CheckOut" class="control-label">Check out</label>
                <input type="date" asp-for="Flat.CheckOut" class="form-control" />
                <span asp-validation-for="Flat.CheckOut" class="text-danger"></span>
            </div>

            <div class="form-group mt-2">
                <label asp-for="Flat.GuestName" class="control-label">Guest Name</label>
                <input asp-for="Flat.GuestName" class="form-control" id="cbGuestName" />
                @* <span asp-validation-for="Flat.GuestName" class="text-danger"></span> *@
            </div>
            <div class="form-group mt-2">
                <label asp-for="Flat.GuestPhone" class="control-label">Guest Phone</label>
                <input asp-for="Flat.GuestPhone" class="form-control" id="cbPhoneNumber" />
                @* <span asp-validation-for="Flat.GuestPhone" class="text-danger"></span> *@
            </div>
            <div class="form-group mt-2">
                <label asp-for="Flat.BookingNumber" class="control-label">Booking No</label>
                <input asp-for="Flat.BookingNumber" class="form-control" />
                @* <span asp-validation-for="Flat.BookingNumber" class="text-danger"></span> *@
            </div>
            @*   <div class="form-group mt-2">
                <label asp-for="Flat.TotalPayment" class="control-label">Price</label>
                <input asp-for="Flat.TotalPayment" class="form-control" id="cbTotalPayment" />
            </div> *@
           
            <div class="form-group mt-2">
                <input type="submit" value="Save" class="btn btn-primary" /> |
                <a asp-page="./Bookings">Cancel</a>
            </div>
        </form>
        <!-- Move booking to another flat -->
        <form method="post" asp-page-handler="Move" class="mt-3">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="SourceFlatId" value="@Model.Flat.Id" />
            <div class="input-group">
                <select asp-for="MoveToFlatId" class="form-select">
                    <option value="">Select a flat to move to...</option>
                    @if (Model.Flats != null)
                    {
                        foreach (var f in Model.Flats)
                        {
                            if (f.Id != Model.Flat.Id)
                            {
                                <option value="@f.Id">@f.Name</option>
                            }
                        }
                    }
                </select>
                <button type="submit" class="btn btn-warning" onclick="return confirm('Move booking to selected flat?');">Move</button>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
