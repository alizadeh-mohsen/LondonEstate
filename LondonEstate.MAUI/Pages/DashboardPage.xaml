<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LondonEstate.MAUI.Pages.DashboardPage"
             Title="Dashboard"
             BackgroundColor="{DynamicResource PageBackgroundColor}"
             Padding="20">

    <ScrollView>
        <VerticalStackLayout Spacing="25">

            <!-- Page Header -->
            <Label Text="Admin Dashboard"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource PrimaryTextColor}" />

            <!-- Grid of Cards -->
            <Grid ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="20"
                  RowSpacing="20">

                <!-- Bookings -->
                <Border Grid.Row="0" Grid.Column="0"
                        Background="{DynamicResource PrimaryColor}"
                        StrokeShape="RoundedRectangle 14"
        Stroke="Transparent"
                        HeightRequest="130">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBookingsTapped"/>
                    </Border.GestureRecognizers>

                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <Label Text="Bookings"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="White" />
                    </VerticalStackLayout>
                </Border>

                <!-- Greetings -->
                <Border Grid.Row="0" Grid.Column="1"
                        Background="{DynamicResource SuccessColor}"
                        StrokeShape="RoundedRectangle 14"
        Stroke="Transparent"
                        HeightRequest="130">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnGreetingsTapped"/>
                    </Border.GestureRecognizers>

                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <Label Text="Greetings"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="White" />
                    </VerticalStackLayout>
                </Border>

                <!-- Instructions -->
                <Border Grid.Row="1" Grid.Column="0"
                        Background="{DynamicResource WarningColor}"
                        StrokeShape="RoundedRectangle 14"
        Stroke="Transparent"
                        HeightRequest="130">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnInstructionsTapped"/>
                    </Border.GestureRecognizers>

                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <Label Text="Instructions"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="White" />
                    </VerticalStackLayout>
                </Border>

                <!-- Invoices -->
                <Border Grid.Row="1" Grid.Column="1"
                        Background="{DynamicResource InfoColor}"
                        StrokeShape="RoundedRectangle 14"
        Stroke="Transparent"
                        HeightRequest="130">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnInvoicesTapped"/>
                    </Border.GestureRecognizers>

                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <Label Text="Invoices"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="White" />
                    </VerticalStackLayout>
                </Border>

            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
