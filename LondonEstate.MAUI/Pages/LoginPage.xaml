<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LondonEstate.MAUI.Pages.LoginPage"
             Title="Login"
             BackgroundColor="{DynamicResource PageBackgroundColor}"
             Padding="20">

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout 
            Padding="0" 
            Spacing="20"
            VerticalOptions="CenterAndExpand">

            <!-- Logo/Header Section -->
            <VerticalStackLayout Spacing="10" Padding="20,40,20,20">
                <Frame BorderColor="Transparent" 
                       CornerRadius="15"
                       Padding="0"
                       HasShadow="True"
                       HeightRequest="80"
                       WidthRequest="80"
                       HorizontalOptions="Center"
                       BackgroundColor="{DynamicResource PrimaryColor}">
                    <Label Text="🏢"
                           FontSize="40"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />
                </Frame>

                <Label Text="London Estate"
                       FontSize="28"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{DynamicResource PrimaryTextColor}"
                       Margin="0,10,0,0" />

                <Label Text="Administration Portal"
                       FontSize="14"
                       HorizontalOptions="Center"
                       TextColor="{DynamicResource SecondaryTextColor}"
                       Margin="0,0,0,10" />
            </VerticalStackLayout>

            <!-- Form Section -->
            <VerticalStackLayout Spacing="16" Padding="10,0">

                <!-- Email Field -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Email Address"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource PrimaryTextColor}" />

                    <Frame BorderColor="{DynamicResource BorderColor}"
       CornerRadius="8"
       Padding="16,12"
       HasShadow="False"
       HeightRequest="48">
                        <Entry x:Name="EmailEntry"
           Placeholder="name@example.com"
           Keyboard="Email"
           TextColor="{DynamicResource PrimaryTextColor}"
           PlaceholderColor="{DynamicResource PlaceholderColor}"
           FontSize="14"
           VerticalOptions="Center" />
                    </Frame>
                </VerticalStackLayout>

                <!-- Password Field -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Password"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource PrimaryTextColor}" />

                    <Frame BorderColor="{DynamicResource BorderColor}"
       CornerRadius="8"
       Padding="16,12"
       HasShadow="False"
       HeightRequest="48">
                        <Entry x:Name="PasswordEntry"
           Placeholder="Enter your password"
           IsPassword="True"
           TextColor="{DynamicResource PrimaryTextColor}"
           PlaceholderColor="{DynamicResource PlaceholderColor}"
           FontSize="14"
           VerticalOptions="Center" />
                    </Frame>
                </VerticalStackLayout>

                <!-- Remember Me & Forgot Password -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,8">

                    <!-- Checkbox + Label -->
                    <HorizontalStackLayout Grid.Column="0" Spacing="5" VerticalOptions="Center">
                        <CheckBox x:Name="RememberMeCheckBox" />
                        <Label Text="Remember me"
                               FontSize="12"
                               TextColor="{DynamicResource SecondaryTextColor}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!-- Forgot Password -->
                    <Label Text="Forgot Password?"
                           Grid.Column="1"
                           FontSize="12"
                           TextColor="{DynamicResource PrimaryColor}"
                           HorizontalTextAlignment="End"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

            </VerticalStackLayout>

            <!-- Error Message -->
            <VerticalStackLayout x:Name="ErrorContainer"
                                 IsVisible="False"
                                 Padding="12"
                                 Spacing="5"
                                 BackgroundColor="#FFE5E5">
                <Label x:Name="ErrorLabel"
                       Text=""
                       TextColor="#C41C3B"
                       FontSize="12"
                       FontAttributes="Bold"
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <!-- Login Button -->
            <Button Text="Sign In"
                    x:Name="LoginButton"
                    BackgroundColor="{DynamicResource PrimaryColor}"
                    TextColor="White"
                    CornerRadius="8"
                    FontAttributes="Bold"
                    FontSize="16"
                    HeightRequest="52"
                    Margin="0,12,0,0"
                    Clicked="OnLoginClicked"
                    Padding="20,14" />

            <!-- Sign Up Link -->
            <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                <Label HorizontalOptions="Center"
                       FontSize="12"
                       TextColor="{DynamicResource SecondaryTextColor}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Don't have an account? " />
                            <Span Text="Sign Up"
                                  TextColor="{DynamicResource PrimaryColor}"
                                  FontAttributes="Bold" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </VerticalStackLayout>

            <!-- Footer -->
            <VerticalStackLayout Spacing="0" Padding="0,20">
                <Label Text="Secure Login"
                       FontSize="11"
                       TextColor="{DynamicResource SecondaryTextColor}"
                       HorizontalOptions="Center"
                       Opacity="0.6" />
                <Label Text="🔒 Your data is encrypted and secure"
                       FontSize="10"
                       TextColor="{DynamicResource SecondaryTextColor}"
                       HorizontalOptions="Center"
                       Opacity="0.5" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
